# Gemini API key — used for summarization, Bengali translation, and categorization
# (via the official @google/genai SDK, model gemini-2.5-flash). Required.
# Without this, RSS items can be fetched but no articles can be generated.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Optional: caps how many articles are generated per refresh cycle. Default
# is 15, sized for Gemini's free tier (5 requests/minute) plus a realistic
# serverless function timeout — see lib/data.ts for the math. Raise this if
# you're on a paid Gemini tier with a higher RPM limit and/or a longer
# Vercel function timeout.
MAX_ARTICLES=""

# Optional: minimum milliseconds between outbound Gemini calls (see
# lib/ai.ts). Default 13000 (~4.6 requests/minute) stays just under Gemini's
# free-tier cap of 5 requests/minute for gemini-2.5-flash. Lower this if
# you've upgraded to a paid tier with more headroom.
GEMINI_MIN_MS_BETWEEN_CALLS=""

# Public site URL, used for metadata, sitemap, and RSS feed generation.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional shared secret required by the /api/debug/news diagnostics route.
# If unset, that route is open (no auth check).
CRON_SECRET=""

# No DATABASE_URL: this project has no database. See lib/data.ts — every
# page is served from an in-memory RSS -> AI -> Next.js cache pipeline
# that refreshes itself automatically every 10 minutes.
