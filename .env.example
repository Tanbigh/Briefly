# Gemini API key — used for summarization, Bengali translation, and categorization
# (via the official @google/genai SDK, model gemini-2.5-flash). Required.
# Without this, RSS items can be fetched but no articles can be generated.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Optional: caps how many *candidate* RSS stories one refresh cycle even
# looks at before AI generation (not a cost control — cached articles are
# free). Default 150. See lib/data.ts.
MAX_ARTICLES=""

# Optional: minimum milliseconds between outbound Gemini calls (see
# lib/ai.ts). Default 13000 (~4.6 requests/minute) stays just under Gemini's
# free-tier cap of 5 requests/minute for gemini-2.5-flash. Lower this if
# you've upgraded to a paid tier with more headroom.
GEMINI_MIN_MS_BETWEEN_CALLS=""

# Public site URL, used for metadata, sitemap, and RSS feed generation.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------
# Background refresh + persistent snapshot (see lib/data.ts, lib/snapshot.ts)
# ---------------------------------------------------------------------

# REQUIRED. Shared secret that authorizes calls to /api/cron/refresh — the
# only route allowed to run the live RSS+AI pipeline. Any long random
# string works (e.g. `openssl rand -hex 32`). The same value must be set
# as a GitHub Actions secret (see .github/workflows/refresh.yml) and, if
# you ever add a vercel.json crons entry, matches what Vercel's own Cron
# auto-injects as CRON_SECRET.
CRON_SECRET=""

# REQUIRED (for persistence). Upstash Redis REST credentials — provision
# via Vercel dashboard -> Storage -> Marketplace -> Upstash Redis, which
# injects these automatically. This is the direct successor to "Vercel
# KV" (now deprecated). Without these, /api/cron/refresh cannot persist
# results and getArticles() always returns an empty list.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# If your integration instead injected KV_REST_API_URL / KV_REST_API_TOKEN,
# lib/snapshot.ts reads those as a fallback — no need to duplicate values.

# Optional shared secret for the /api/debug/news health endpoint
# (?key=...). If unset, that route is open — it only exposes feed health
# and article counts, nothing sensitive.
DEBUG_SECRET=""

# Optional: how long (ms) a single /api/cron/refresh run will spend on NEW
# Gemini generations before deferring the rest to the next cycle. Default
# 42000, sized to leave headroom inside that route's 60s maxDuration
# (Vercel Hobby's ceiling). See lib/data.ts.
NEW_ARTICLE_TIME_BUDGET_MS=""

# Optional: caps brand-new Gemini calls per refresh cycle. Default 5.
MAX_NEW_ARTICLES_PER_REFRESH=""

# Optional: how many articles the persisted snapshot holds at most.
# Default 60.
MAX_SNAPSHOT_ARTICLES=""

# Optional: logging/health-check target only (does not gate what's shown).
# /api/debug/news and cron logs flag when the snapshot is below this.
# Default 8.
MIN_DESIRED_ARTICLES=""

# No DATABASE_URL: this project still has no relational database. The
# only persistent state is the single JSON snapshot in Redis described
# above — see lib/data.ts and lib/snapshot.ts for the full architecture.
